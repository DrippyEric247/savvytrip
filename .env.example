# =============================================================================
# SavvyTrip environment template — NAMES ONLY (never commit real secrets/values)
# Copy to `.env.local` for local dev. Set the same VITE_* vars in your host
# build environment for production (Vite bakes them at build time).
# =============================================================================

# -----------------------------------------------------------------------------
# Local development (optional)
# -----------------------------------------------------------------------------
# Vite dev server API proxy target (server-side only; not exposed to browser bundle)
# VITE_DEV_API_PROXY=http://localhost:5000

# Browser/API origin without trailing /api (local: leave unset to use Vite proxy on :5173)
# VITE_API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Production / beta (required on the hosting provider before `npm run build`)
# -----------------------------------------------------------------------------
# Final10 / Savvy Universe API origin (no /api suffix)
# Example: https://api.final10.app
# VITE_API_URL=https://api.final10.app

# Public site origin for docs/OAuth registration (not read by app code today; register manually)
# VITE_PUBLIC_APP_ORIGIN=https://savvytrip.app

# Fallback if VITE_API_URL is unset in a production bundle (optional; default in code is api.final10.app)
# VITE_DEFAULT_API_ORIGIN=https://api.final10.app

# -----------------------------------------------------------------------------
# Optional — dev / proof UI (no secrets)
# -----------------------------------------------------------------------------
# Expose /dev/savvy-core-proof in production builds (admin still required). Leave unset for public beta.
# VITE_ENABLE_CORE_PROOF=true

# Backend proof flags live on Final10 API (SAVVY_CORE_*), not in this frontend repo.

# Host listen port when using `npm start` (Railway sets PORT automatically)
# PORT=8080
